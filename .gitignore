# ALLOW-LIST: this folder also holds Akai's firmware dumps and analysis of their code,
# which must never be committed. Only our own firmware source and docs are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/FIRE_HARDWARE_MAP.md
!/fw/
!/installer/
!/.github/
!/tools/

# the installer's scripts are tracked; its binaries ship only in the release zip, and backups never leave the PC
installer/**/*.exe
installer/**/*.bin
installer/**/*.zip
installer/backups/
installer/dist/
installer/files/COPYING*

# build outputs and scratch inside fw/
fw/**/*.bin
fw/**/*.elf
fw/**/*.map
fw/**/*.o
fw/**/*.pbm
fw/**/*.json
fw/**/__pycache__/
fw/hello/ref/
